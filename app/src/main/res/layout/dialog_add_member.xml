<?xml version="1.0" encoding="utf-8"?>
<!-- Body of the add/rename member DialogFragment. Owner: Mohammad. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_xlarge">

    <TextView
        style="@style/TextSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@id/edit_member_name"
        android:text="@string/label_member_name" />

    <EditText
        android:id="@+id/edit_member_name"
        style="@style/FormField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="no"
        android:inputType="textPersonName|textCapWords"
        android:maxLength="30" />

    <TextView
        style="@style/FormLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@id/edit_member_phone"
        android:text="@string/label_member_phone" />

    <EditText
        android:id="@+id/edit_member_phone"
        style="@style/FormField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="no"
        android:inputType="phone" />

</LinearLayout>
