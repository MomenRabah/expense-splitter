<?xml version="1.0" encoding="utf-8"?>
<!-- Body of the create/edit group DialogFragment. Owner: Mohammad. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_xlarge">

    <TextView
        style="@style/TextSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@id/edit_group_name"
        android:text="@string/label_group_name" />

    <EditText
        android:id="@+id/edit_group_name"
        style="@style/FormField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_group_name"
        android:importantForAutofill="no"
        android:inputType="textCapWords"
        android:maxLength="40" />

    <TextView
        style="@style/FormLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_group_type" />

    <Spinner
        android:id="@+id/spinner_group_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/group_types"
        android:minHeight="@dimen/touch_target" />

</LinearLayout>
